# ---------------------------------------------------------------------------
# Florida Hometown Heroes — environment variables
# Copy to .env.local for local dev, and set in Vercel:
#   Project Settings -> Environment Variables
# ---------------------------------------------------------------------------

# Go High Level inbound webhook that receives lead submissions from /api/lead.
# The endpoint POSTs the enriched lead JSON (contact + profile + calculator +
# consent + meta + server{received_at, ip, user_agent}) to this URL.
#
# If this is UNSET, /api/lead does NOT drop the lead: it logs the full payload
# at error level and returns 200 (recoverable from Vercel logs). Set it before
# launch so leads actually reach the CRM.
GHL_WEBHOOK_URL=
