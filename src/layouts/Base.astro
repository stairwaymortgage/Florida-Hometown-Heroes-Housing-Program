---
// Shared shell. Header/footer are now rendered at build time (previously
// injected at runtime by includes.js), so search engines see them.
import header from '../raw/header.html?raw';
import footer from '../raw/footer.html?raw';
interface Props { head: string; main?: string; tail?: string; }
const { head, main = '', tail = '' } = Astro.props;
// Highlight the current nav link (replaces includes.js highlightActiveLink).
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const nav = header.replace(/<nav[\s\S]*?<\/nav>/, (block) =>
  block.replace(`<a href="${path}">`, `<a href="${path}" class="nav-active">`)
);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/style.css">
  <Fragment set:html={head} />
</head>
<body>
  <Fragment set:html={nav} />
  {main ? <Fragment set:html={main} /> : <slot />}
  <Fragment set:html={footer} />
  <Fragment set:html={tail} />
</body>
</html>
